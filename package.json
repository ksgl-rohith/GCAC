{
  "name": "gcac-vulnerability-remediation",
  "displayName": "GCAC Vulnerability Remediation Hub",
  "description": "Local Multi-Agent Security Remediation and Governance Dashboard for VS Code",
  "version": "1.0.0",
  "publisher": "gcac",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Security",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onView:gcac.remediationView",
    "onCommand:gcac.openDashboard",
    "onChatParticipant:gcac.vulnerability-orchestrator"
  ],
  "main": "./extension/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gcac.openDashboard",
        "title": "GCAC: Open Remediation Dashboard",
        "category": "GCAC",
        "icon": "$(shield)"
      },
      {
        "command": "gcac.refreshData",
        "title": "GCAC: Refresh Vulnerability Records",
        "category": "GCAC",
        "icon": "$(refresh)"
      },
      {
        "command": "gcac.viewDiff",
        "title": "GCAC: View Remediation Diff",
        "category": "GCAC",
        "icon": "$(diff)"
      },
      {
        "command": "gcac.scanRepository",
        "title": "GCAC: Scan Repository for Vulnerabilities",
        "category": "GCAC",
        "icon": "$(search)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gcac-remediation-hub",
          "title": "GCAC Remediation",
          "icon": "$(shield)"
        }
      ]
    },
    "views": {
      "gcac-remediation-hub": [
        {
          "type": "webview",
          "id": "gcac.remediationView",
          "name": "Remediation Hub"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "gcac.vulnerability-orchestrator",
        "name": "vulnerability-orchestrator",
        "description": "Autonomous Multi-Agent Vulnerability Remediation Coordinator",
        "isDefault": false,
        "commands": [
          {
            "name": "remediate-vulnerability",
            "description": "Execute the 7-stage autonomous LLM remediation pipeline on a vulnerability"
          },
          {
            "name": "approve",
            "description": "Grant Stage 4 Human Approval to apply patch and run Bench Tests"
          },
          {
            "name": "final-approve",
            "description": "Grant Stage 6 Final Approval and Sign-off"
          }
        ]
      }
    ]
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "GCAC Remediation Hub modifies files, runs local process validation, and accesses local repositories. A trusted workspace is required."
    }
  },
  "scripts": {
    "test": "node tests/extension/run-all-tests.js",
    "start:preview": "node scripts/preview-dashboard.js"
  }
}
